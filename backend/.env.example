# Copy to backend/.env. Values here are not secrets.

# Local default. In production set this to the exact Vercel origin, for example https://your-app.vercel.app.
# A wildcard is rejected. See docs/DEPLOYMENT.md.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Leave empty to use ml/models/phishing_rf.joblib and the matching config and metrics files.
MODEL_PATH=
FEATURE_CONFIG_PATH=
METRICS_PATH=

# Leave empty to use backend/data/intellishield.db. Stored URLs have userinfo and query values removed.
DATABASE_URL=

# Direct-client limit for POST /api/v1/predict and GET /api/v1/history. Health is not limited.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Leave the key empty to skip the language model. The classifier result is still returned,
# with analysis.source set to fallback. The key is never written into source code.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=20
